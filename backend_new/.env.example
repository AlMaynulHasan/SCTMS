# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Microsoft SQL Server)
# Examples: localhost, localhost\SQLEXPRESS, or a hosted SQL Server address
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SCTMS
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Authentication
JWT_SECRET=your_super_secret_random_string
JWT_EXPIRES_IN=7d

# Email / SMTP
# Leave blank for local testing if email OTP is not needed.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
